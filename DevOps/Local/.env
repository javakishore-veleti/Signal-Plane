# Shared by every stack under DevOps/Local.
# Each docker-compose.yaml reads this file, so ports and credentials are
# declared once rather than drifting between stacks.

COMPOSE_NETWORK=signal-plane-net

POSTGRES_USER=signalplane
POSTGRES_PASSWORD=signalplane
POSTGRES_DB=signalplane
POSTGRES_PORT=5432

KAFKA_PORT=9092
KAFKA_ADMIN_PORT=9644

REDIS_PORT=6379

MINIO_ROOT_USER=signalplane
MINIO_ROOT_PASSWORD=signalplane
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=signal-plane-payloads

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
GRAFANA_PORT=3000

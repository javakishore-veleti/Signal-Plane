{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-plane.dev/schemas/adapter-manifest/v1.json",
  "title": "Adapter manifest",
  "description": "Declared by every adapter at registration. The control plane uses it to answer coverage discovery: which sources can observe this subject, at what fidelity, under which capture modes.",
  "type": "object",
  "required": ["adapter_id", "version", "source_system", "delivery", "emits"],
  "additionalProperties": false,
  "properties": {
    "adapter_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "version": { "type": "string" },
    "source_system": { "type": "string" },
    "runtime": { "enum": ["lambda_python", "container", "edge_agent"] },
    "delivery": { "enum": ["pull_poll", "push_webhook", "stream_subscribe"] },
    "min_interval_seconds": { "type": "integer", "minimum": 0 },
    "capture_modes": { "type": "array", "items": { "enum": ["passive_metadata", "content_capture", "continuous_screen", "triggered_screen", "language_analysis"] } },
    "requires_authority": { "type": "boolean", "default": true },
    "emits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["signal_type", "category", "fidelity"],
        "properties": {
          "signal_type": { "type": "string" },
          "category": { "type": "string" },
          "fidelity": { "enum": ["exact", "sampled", "inferred"] },
          "emits_payload_ref": { "type": "boolean", "default": false }
        }
      }
    },
    "identity_kinds": { "type": "array", "items": { "type": "string" }, "description": "Identifier kinds this source can supply, used by subject resolution." }
  }
}

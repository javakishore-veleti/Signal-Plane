{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-plane.dev/schemas/authority-decision/v1.json",
  "title": "Authority decision",
  "description": "Produced by the control plane before any capture session opens. Who must approve depends on the capture mode, and the governing rule depends on the jurisdiction of the subject, not of the tenant.",
  "type": "object",
  "required": ["decision_id", "tenant_id", "subject_id", "capture_mode", "granted", "basis", "policy_version", "evaluated_at"],
  "additionalProperties": false,
  "properties": {
    "decision_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "capture_mode": {
      "enum": ["passive_metadata", "content_capture", "continuous_screen", "triggered_screen", "language_analysis"],
      "description": "Escalating intrusiveness. Each mode names a different approving party in policy."
    },
    "granted": { "type": "boolean" },
    "basis": { "enum": ["notice", "consent", "contract", "legitimate_interest", "legal_obligation"] },
    "approver": {
      "type": "object",
      "properties": {
        "role": { "enum": ["subject", "employer", "works_council", "data_protection_officer"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "evidence_ref": { "type": "string" }
      }
    },
    "jurisdiction": { "type": "string" },
    "policy_version": { "type": "string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time", "description": "Decisions are always bounded. An unbounded grant is a defect." },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schedule_windows": {
          "type": "array",
          "description": "Capture is closed outside these windows. Session termination is rule driven, not operator driven.",
          "items": {
            "type": "object",
            "required": ["days", "start", "end", "timezone"],
            "properties": {
              "days": { "type": "array", "items": { "enum": ["mon","tue","wed","thu","fri","sat","sun"] } },
              "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "timezone": { "type": "string" }
            }
          }
        },
        "excluded_categories": { "type": "array", "items": { "type": "string" } },
        "excluded_destinations": { "type": "array", "items": { "type": "string" }, "description": "Domains or applications never captured, e.g. banking, health, union sites." },
        "redaction_profile": { "type": "string" }
      }
    },
    "denial_reason": { "type": "string" }
  }
}
